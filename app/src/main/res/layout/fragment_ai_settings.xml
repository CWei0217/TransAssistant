<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorUiBgPage"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- 顶栏：与 OCR 页同规范（本页不设主题按钮，避免无监听器的空控件） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.03"
                android:text="@string/ai_engine_title"
                android:textColor="?attr/colorUiTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.01"
                android:text="@string/ai_screen_subtitle"
                android:textColor="?attr/colorUiTextSecondary"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorUiLine" />
        </LinearLayout>

        <!-- 服务商 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/colorUiSurfaceCard"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorUiCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/service_provider"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:boxStrokeWidth="1dp"
                    app:hintEnabled="false">

                    <AutoCompleteTextView
                        android:id="@+id/spinner_ai_provider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:padding="12dp"
                        android:saveEnabled="false"
                        android:textColor="?attr/colorUiTextPrimary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layerType="software"
            android:background="@drawable/dotted_rule" />

        <!-- 凭据与连接 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorUiSurfaceCard"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorUiCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/security_credentials"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_ai_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/et_ai_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/api_token"
                        android:importantForAutofill="no"
                        android:inputType="textPassword" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_yiyan_credentials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <EditText
                        android:id="@+id/et_ai_ak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/access_key"
                        android:importantForAutofill="no" />

                    <EditText
                        android:id="@+id/et_ai_sk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/secret_key"
                        android:importantForAutofill="no"
                        android:inputType="textPassword" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_ai_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/endpoint_url"
                    android:importantForAutofill="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_connection"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:text="@string/execute_connection_test"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fetch_models"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/fetch_models"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorPrimary"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layerType="software"
            android:background="@drawable/dotted_rule" />

        <!-- 引擎参数 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorUiSurfaceCard"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorUiCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/engine_parameters"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:boxStrokeWidth="1dp"
                    app:hintEnabled="false">

                    <AutoCompleteTextView
                        android:id="@+id/et_ai_model"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/model_identifier"
                        android:padding="12dp"
                        android:saveEnabled="false"
                        android:textColor="?attr/colorUiTextPrimary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:boxStrokeColor="@color/text_input_box_stroke"
                        app:boxStrokeWidth="1dp"
                        app:hintEnabled="false">

                        <AutoCompleteTextView
                            android:id="@+id/et_source_lang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/source_lang"
                            android:inputType="none"
                            android:padding="12dp"
                            android:saveEnabled="false"
                            android:textColor="?attr/colorUiTextPrimary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:boxStrokeColor="@color/text_input_box_stroke"
                        app:boxStrokeWidth="1dp"
                        app:hintEnabled="false">

                        <AutoCompleteTextView
                            android:id="@+id/et_target_lang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/target_lang"
                            android:inputType="none"
                            android:padding="12dp"
                            android:saveEnabled="false"
                            android:textColor="?attr/colorUiTextPrimary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.06"
                    android:text="@string/creativity_index"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_slider_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_temp"
                        style="@style/Widget.App.Slider.Settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:stepSize="0.1"
                        android:valueFrom="0.0"
                        android:valueTo="1.0" />

                    <TextView
                        android:id="@+id/tv_temp_value"
                        android:layout_width="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0.3"
                        android:textColor="?attr/colorUiTextPrimary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layerType="software"
            android:background="@drawable/dotted_rule" />

        <!-- Prompt -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorUiSurfaceCard"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorUiCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/directives_prompt"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_system_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="top|start"
                    android:hint="@string/system_role"
                    android:importantForAutofill="no"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/et_user_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="top|start"
                    android:hint="@string/user_template"
                    android:importantForAutofill="no"
                    android:minLines="3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layerType="software"
            android:background="@drawable/dotted_rule" />

        <!-- 按键映射 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorUiSurfaceCard"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorUiCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/gamepad_mapping"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_gamepad_mapping_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="未设置"
                    android:textColor="?attr/colorUiTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_gamepad_mapping"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/select_gamepad_mapping"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorPrimary"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_mapping_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/newspaper_input_bg"
                    android:padding="12dp"
                    android:text="@string/gamepad_mapping_hint_tap_to_start"
                    android:textColor="?attr/colorUiTextSecondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_gamepad_mapping"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/restore_default_gamepad_mapping"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layerType="software"
            android:background="@drawable/dotted_rule" />

        <!-- 翻译结果显示 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorUiSurfaceCard"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorUiCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/display_settings"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="0.06"
                    android:text="@string/result_display_mode_title"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_result_window_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_result_follow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/selector_bg_ocr_provider_row"
                        android:buttonTint="?attr/colorPrimary"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp"
                        android:text="@string/result_mode_follow"
                        android:textColor="@color/selector_radio_provider_row_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rb_result_fixed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/selector_bg_ocr_provider_row"
                        android:buttonTint="?attr/colorPrimary"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp"
                        android:text="@string/result_mode_fixed"
                        android:textColor="@color/selector_radio_provider_row_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rb_result_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/selector_bg_ocr_provider_row"
                        android:buttonTint="?attr/colorPrimary"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp"
                        android:text="@string/result_mode_subtitle"
                        android:textColor="@color/selector_radio_provider_row_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.06"
                    android:text="@string/background_opacity"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_slider_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_result_alpha"
                        style="@style/Widget.App.Slider.Settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:stepSize="0.05"
                        android:valueFrom="0.0"
                        android:valueTo="1.0" />

                    <TextView
                        android:id="@+id/tv_result_alpha_value"
                        android:layout_width="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1.0"
                        android:textColor="?attr/colorUiTextPrimary"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.06"
                    android:text="@string/font_magnification"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_slider_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_result_font_size"
                        style="@style/Widget.App.Slider.Settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:stepSize="1.0"
                        android:valueFrom="10.0"
                        android:valueTo="30.0" />

                    <TextView
                        android:id="@+id/tv_result_font_size_value"
                        android:layout_width="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="15"
                        android:textColor="?attr/colorUiTextPrimary"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.06"
                    android:text="@string/display_timeout"
                    android:textAllCaps="true"
                    android:textColor="?attr/colorUiTextSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_slider_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_result_duration"
                        style="@style/Widget.App.Slider.Settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:stepSize="1.0"
                        android:valueFrom="0.0"
                        android:valueTo="60.0" />

                    <TextView
                        android:id="@+id/tv_result_duration_value"
                        android:layout_width="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="?attr/colorUiTextPrimary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
