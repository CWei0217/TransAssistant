<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="4dp">

    <!-- 选区 + 四边中点浅灰胶囊调节条（手柄须在工具条之前声明） -->
    <FrameLayout
        android:id="@+id/selection_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/selection_frame"
            android:layout_width="250dp"
            android:layout_height="180dp"
            android:background="@drawable/selection_border"
            android:orientation="vertical">

            <View
                android:id="@+id/inner_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- 顶边中点 -->
        <FrameLayout
            android:id="@+id/handle_top"
            android:layout_width="56dp"
            android:layout_height="16dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-8dp">

            <View
                android:layout_width="44dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:background="@drawable/selection_edge_capsule" />
        </FrameLayout>

        <!-- 底边中点 -->
        <FrameLayout
            android:id="@+id/handle_bottom"
            android:layout_width="56dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-8dp">

            <View
                android:layout_width="44dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:background="@drawable/selection_edge_capsule" />
        </FrameLayout>

        <!-- 左边中点 -->
        <FrameLayout
            android:id="@+id/handle_left"
            android:layout_width="16dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="-8dp">

            <View
                android:layout_width="6dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/selection_edge_capsule" />
        </FrameLayout>

        <!-- 右边中点 -->
        <FrameLayout
            android:id="@+id/handle_right"
            android:layout_width="16dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="-8dp">

            <View
                android:layout_width="6dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/selection_edge_capsule" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/selection_toolbar_bg"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/btn_start"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_map_key"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:contentDescription="@string/select_gamepad_mapping"
            android:src="@drawable/ic_nav_settings_gear"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
