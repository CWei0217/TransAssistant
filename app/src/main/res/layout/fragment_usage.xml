<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorUiBgPage"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- 顶栏：标题 + 深浅色切换（与 design-preview 一致语义） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/midnight_press"
                        android:textColor="?attr/colorUiTextPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.03" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/app_name"
                        android:textColor="?attr/colorUiTextSecondary"
                        android:textSize="13sp"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginEnd="-8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 两键同格 56dp，符号与图标 34 量级一致 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="34sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_accent_menu"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="-20dp"
                        android:contentDescription="@string/theme_accent_menu_cd"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_more_vert"
                        app:iconPadding="0dp"
                        app:iconSize="34dp"
                        app:iconTint="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorUiLine" />
        </LinearLayout>

        <!-- 卡片 1：当前翻译配置 + 语言栏 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/colorUiSurfaceCard"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorUiCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_translation_vector"
                    android:textColor="?attr/colorUiTextMuted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lang_pill"
                        android:minHeight="48dp"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/tv_main_source_lang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/auto_detect"
                            android:textColor="?attr/colorUiTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_swap_lang" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lang_pill"
                        android:minHeight="48dp"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/tv_main_target_lang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/chinese"
                            android:textColor="?attr/colorUiTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片 2：状态 + 启动识别 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorUiSurfaceCard"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorUiCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_status"
                    android:textColor="?attr/colorUiTextSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip_config"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:text="[ACTIVE] BAIDU+DEEPSEEK"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_capture"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:minHeight="52dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="@string/initialize_capture"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_logs"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/open_log_center"
                    android:textAllCaps="false" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="18dp"
                    android:layerType="software"
                    android:background="@drawable/dotted_rule" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 历史 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:letterSpacing="0.08"
                android:text="@string/operational_archives"
                android:textAllCaps="true"
                android:textColor="?attr/colorUiTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_history"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/purge"
                android:textAllCaps="false"
                    android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layout_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_empty_history"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:text="@string/data_stream_empty"
                android:textColor="?attr/colorUiTextMuted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
