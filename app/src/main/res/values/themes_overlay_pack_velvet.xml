<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlayPackVelvet">
        <item name="colorUiBgPage">@color/pack_velvet_bg_page</item>
        <item name="colorUiSurface">@color/pack_velvet_surface</item>
        <item name="colorUiSurfaceCard">@color/pack_velvet_surface_card</item>
        <item name="colorUiAccent">@color/pack_velvet_accent</item>
        <item name="colorUiAccentSoft">@color/pack_velvet_accent_soft</item>
        <item name="colorUiTextPrimary">@color/pack_velvet_text_primary</item>
        <item name="colorUiTextSecondary">@color/pack_velvet_text_secondary</item>
        <item name="colorUiTextMuted">@color/pack_velvet_text_muted</item>
        <item name="colorUiLine">@color/pack_velvet_line</item>
        <item name="colorUiLangPillBg">@color/pack_velvet_lang_pill_bg</item>
        <item name="colorUiChipStroke">@color/pack_velvet_chip_stroke</item>
        <item name="colorUiCardStroke">@color/pack_velvet_card_stroke</item>
        <item name="colorUiSliderTrackInactive">@color/pack_velvet_slider_track_inactive</item>
        <item name="colorUiStatusSuccess">@color/pack_velvet_status_success</item>
        <item name="colorUiStatusError">@color/pack_velvet_status_error</item>
        <item name="colorUiStatusPending">@color/pack_velvet_status_pending</item>

        <item name="colorPrimary">@color/pack_velvet_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pack_velvet_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/pack_velvet_text_primary</item>
        <item name="colorSecondary">@color/pack_velvet_secondary</item>
        <item name="colorOnSecondary">@color/pack_velvet_on_secondary</item>
        <item name="colorSecondaryContainer">@color/pack_velvet_secondary_soft</item>
        <item name="colorOnSecondaryContainer">@color/pack_velvet_text_primary</item>
        <!-- 与底栏栗褐解耦：Outlined TextField 等使用 colorSurface 作盒内底，避免黑字压在红底上 -->
        <item name="colorSurface">@color/pack_velvet_surface_card</item>
        <item name="colorOnSurface">@color/pack_velvet_text_primary</item>
        <item name="android:colorBackground">@color/pack_velvet_bg_page</item>
        <item name="colorOnBackground">@color/pack_velvet_text_primary</item>
        <item name="android:windowBackground">@color/pack_velvet_bg_page</item>
        <item name="android:statusBarColor">@color/pack_velvet_surface</item>
        <item name="android:navigationBarColor">@color/pack_velvet_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
